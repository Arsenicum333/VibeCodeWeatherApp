{
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "endOfLine": "lf",
    "printWidth": 105,
    "tabWidth": 4,
    "trailingComma": "es5",
    "overrides": [
        {
            "files": ["**/tsconfig.json", "**/tsconfig.*.json"],
            "options": {
                "parser": "jsonc",
                "trailingComma": "none"
            }
        },
        {
            "files": "*.html",
            "options": {
                "parser": "angular"
            }
        }
    ]
}
